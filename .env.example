# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database & Vector Store (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/researchpilot?schema=public

# Redis Cache
REDIS_URL=redis://localhost:6379

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_AUDIT_MODEL=gpt-4o

# Optional LLM & Search Providers
GROQ_API_KEY=
TAVILY_API_KEY=

